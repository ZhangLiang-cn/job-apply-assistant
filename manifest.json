{
  "manifest_version": 3,
  "name": "岗位自动投递助手 · 5平台模拟操作",
  "version": "1.2.3",
  "description": "BOSS直聘 / 智联招聘 / 猎聘 / 前程无忧 / 鱼泡直聘五平台岗位筛选与页面操作扩展。默认演练模式；真实投递需用户主动切换并二次确认。仅操作页面可见控件，不直接调用平台业务接口。",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://www.zhaopin.com/*",
    "https://www.liepin.com/*",
    "https://safe.liepin.com/*",
    "https://*.liepin.com/*",
    "https://we.51job.com/*",
    "https://www.yupao.com/*"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "岗位自动投递助手",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
